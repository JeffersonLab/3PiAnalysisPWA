#THESE TWO ARE OPTIONAL IF THE STANDARD RUNNING DOESN'T SUIT YOUR NEEDS
#CUSTOM_MAKEMC=use-this-script-instead
#CUSTOM_GCONTROL=use-this-Gcontrol-instead
#========================================================================

VARIATION=mc #set your jana calib context here with or without calibtime Default is variation=mc

RCDB_QUERY=@is_2018production and @status_approved and polarization_angle==135
DATA_OUTPUT_BASE_DIR=/volatile/halld/home/afzal/signalmc/signalbgfitmethod/rho770_angle135/

#ANA_ENVIRONMENT_FILE=/group/halld/www/halldweb/html/halld_versions/analysis-2017_01-ver36.xml
ANA_ENVIRONMENT_FILE=/group/halld/www/halldweb/html/halld_versions/analysis-2018_01-ver15.xml
#ANA_ENVIRONMENT_FILE=/group/halld/www/halldweb/html/halld_versions/analysis-2018_08-ver06.xml

NCORES=1      # Number of CPU threads to use or nodes:node-id:ppn or nodes:ppn depending on your system

GENERATOR=gen_amp #or you may specifile file:/.../file-to-use.hddm
GENERATOR_CONFIG=/work/halld/home/afzal/configfiles/gen_deltaSDME_signalMC_rho770bg135.cfg

#common parameters for generators
FLUX_TO_GEN=ccdb
eBEAM_ENERGY=rcdb #either use rcdb or do not set to pull the value for the chosen run number from the rcdb
RADIATOR_THICKNESS=rcdb #either use rcdb or do not set to pull the value for the chosen run number from the rcdb
COHERENT_PEAK=rcdb #either use rcdb or do not set to pull the value for the chosen run number from the rcdb
GEN_MIN_ENERGY=8.2
GEN_MAX_ENERGY=8.8

GEANT_VERSION=4
BKG=Random:recon-2018_01-ver02.2+NoTag
#Random:recon-2017_01-ver03.2
#Random:recon-2018_01-ver02.2
#Random:recon-2018_08-ver02.2

CUSTOM_PLUGINS=file:/work/halld/home/afzal/configfiles/3230_jana.config

#====================================================================================
#EVERYTHING BELOW FOR BATCH ONLY

#VERBOSE=True

BATCH_SYSTEM=swif2 #can be swif or condor or osg or qsub adding :[name] will pass -q [name] into PBS. 

#environment file location
ENVIRONMENT_FILE=/work/halld/home/afzal/setup_gluex_2018_01.csh #/work/halld/home/afzal/recon-2018_01-ver02_27.xml  #change this to your own environment file

WORKFLOW_NAME=MC_ppippim_genamp_signal_10mio #SWIF WORKFLOW NAME
PROJECT = GlueX          # http://scicomp.jlab.org/scicomp/#/projects
TRACK= simulation     	   # https://scicomp.jlab.org/docs/batch_job_tracks

# RESOURCES for swif jobs
DISK=5GB            # Max Disk usage
RAM=1500MB           # Max RAM usage
TIMELIMIT=1200minutes      # Max walltime.  This may be of the form xx:xx:xx depending on your system
OS=centos79       # Specify CentOS65 machines